#!/usr/bin/env bash
# wp-restore — re-apply the last wallpaper at session start (called by niri)
MODE_FILE="$HOME/.cache/wp-mode"
WPCACHE="$HOME/.cache/wp-current"

[ -f "$WPCACHE" ] || exit 0
sleep 1

if [ "$(cat "$MODE_FILE" 2>/dev/null)" = "pandora" ]; then
    pgrep -x pandora >/dev/null || setsid nohup pandora >/dev/null 2>&1 &
else
    pgrep -x awww-daemon >/dev/null || setsid awww-daemon >/dev/null 2>&1 &
    sleep 0.3
    awww img "$(cat "$WPCACHE")"
fi
